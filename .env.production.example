NODE_ENV=production
PORT=3000

# Public site URL used by Socket.IO and auth redirects.
NEXT_PUBLIC_SITE_URL=https://klyihao.com

# Auth.js / NextAuth secret. Use the same random value for both.
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional support links.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_TELEGRAM=

# Leave empty to use the Redis container from docker-compose.prod.yml.
REDIS_URL=redis://redis:6379
